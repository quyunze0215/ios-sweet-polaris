+/*
+ * POLARIS dual-boot: expose only a window of the named partition as the root
+ * device, so the iOS root image can live in the tail of `userdata` while
+ * Android's f2fs keeps the front of it.  Boot args, in bytes:
+ *
+ *   ufsrootoff=<offset>   start of the window inside the partition (4 KiB aligned)
+ *   ufsrootsize=<size>    length of the window (default: to the partition end)
+ *
+ * Android's filesystem is shrunk below ufsrootoff first, so nothing outside the
+ * window is ever read or written; ufs_write_blocks() keeps its bounds checks
+ * against nblocks and therefore also cannot leave the window.
+ */
+static int
+ufs_apply_window(uint64_t off, uint64_t size)
+{
+	if (off % UFS_BLOCK) {
+		printf("SWEET UFS: ufsrootoff %llu is not %u-byte aligned\n",
+		    off, UFS_BLOCK);
+		return EINVAL;
+	}
+	uint64_t skip = off / UFS_BLOCK;
+	if (skip >= su.nblocks) {
+		printf("SWEET UFS: ufsrootoff %llu MiB beyond the %llu MiB partition\n",
+		    off >> 20, su.nblocks * UFS_BLOCK >> 20);
+		return EINVAL;
+	}
+	uint64_t total_blocks = su.nblocks;
+	uint64_t avail = total_blocks - skip;
+	uint64_t want = size ? (size + UFS_BLOCK - 1) / UFS_BLOCK : avail;
+	if (want == 0 || want > avail) {
+		printf("SWEET UFS: ufsrootsize %llu MiB does not fit in %llu MiB\n",
+		    size >> 20, avail * UFS_BLOCK >> 20);
+		return EINVAL;
+	}
+	su.first_block += skip;
+	su.nblocks = want;
+	printf("SWEET UFS: root window %llu MiB at +%llu MiB of a %llu MiB partition\n",
+	    want * UFS_BLOCK >> 20, off >> 20, total_blocks * UFS_BLOCK >> 20);
+	return 0;
+}
